---
import Navbar from "../../components/navbar.astro";
import Styles from "../../components/styles.astro";
import Banner from "../../components/banner.astro";
import Footer from "../../components/footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sandbox Escape - Volunteers</title>
    <Styles />
  </head>
  <body>
    <Banner />
    <Navbar />
    <main class="container mt-4">
      <h1>Volunteers</h1>

      <p>
        These are the people working on making Sandbox Escape the best it can
        be.
      </p>

      <hr />

      <div class="volunteers-grid">
        <div class="native-form volunteer-card">
          <div class="form-group">
            <div class="form-row volunteer-identity-row">
              <img class="profile-avatar" src="/ponder-avatar.jpeg" alt="" />
              <div>
                <div class="volunteer-name">Ponder</div>
                <div class="volunteer-role">Founder</div>
              </div>
            </div>
            <div class="form-row volunteer-links-row">
              <span class="volunteer-links-label">Links</span>
              <a class="volunteer-link" href="https://github.com/ponderdev"
                >GitHub</a
              >
              <a
                class="volunteer-link"
                href="https://discord.com/users/1362780337314205856">Discord</a
              >
              <a class="volunteer-link" href="https://www.youtube.com/@ImPonder"
                >Youtube</a
              >
            </div>
          </div>
        </div>

        <div class="native-form volunteer-card">
          <div class="form-group">
            <div class="form-row volunteer-identity-row">
              <img class="profile-avatar" src="/nodata-avatar.png" alt="" />
              <div>
                <div class="volunteer-name">ks3h0</div>
                <div class="volunteer-role">Co-Owner</div>
              </div>
            </div>
            <div class="form-row volunteer-links-row">
              <span class="volunteer-links-label">Links</span>
              <a
                class="volunteer-link"
                href="https://discord.com/users/1526171818753523843">Discord</a
              >
              <a class="volunteer-link" href="https://github.com/ks3h0"
                >Github</a
              >
            </div>
          </div>
        </div>

        <div class="native-form volunteer-card">
          <div class="form-group">
            <div class="form-row volunteer-identity-row">
              <img class="profile-avatar" src="/nykenik24-avatar.png" alt="" />
              <div>
                <div class="volunteer-name">Nykenik24</div>
                <div class="volunteer-role">Web Developer</div>
              </div>
            </div>
            <div class="form-row volunteer-links-row">
              <span class="volunteer-links-label">Links</span>
              <a
                class="volunteer-link"
                href="https://discord.com/users/927288268054229062">Discord</a
              >
            </div>
          </div>
        </div>

        <div class="native-form volunteer-card">
          <div class="form-group">
            <div class="form-row volunteer-identity-row">
              <img
                class="profile-avatar"
                src="/unstoppablecat124-avatar.png"
                alt=""
              />
              <div>
                <div class="volunteer-name">unstoppablecat124</div>
                <div class="volunteer-role">Community Admin</div>
              </div>
            </div>
            <div class="form-row volunteer-links-row">
              <span class="volunteer-links-label">Links</span>
              <a
                class="volunteer-link"
                href="https://discord.com/users/1495255088061747230">Discord</a
              >
            </div>
          </div>
        </div>
      </div>

      <p>
        <b>Note:</b>
        Some members may not be listed for privacy reasons, lack of role, no recent
        activity, or other reasons.
      </p>

      <h1>We are <i>always</i> open for new volunteers!</h1>

      <p>
        We are open to join applications. Check it out <a href="/join">here</a>!
      </p>
    </main>
    <Footer />
  </body>
</html>
