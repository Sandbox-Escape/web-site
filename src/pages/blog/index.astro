---
import { getCollection } from "astro:content";
import Navbar from "../../components/navbar.astro";
import Styles from "../../components/styles.astro";
import Banner from "../../components/banner.astro";
import Footer from "../../components/footer.astro";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Sandbox Escape - Blog</title>
    <Styles />
  </head>
  <body>
    <Banner />
    <Navbar />
    <main>
      <div class="container mt-4">
        <div class="native-form" style="max-width: 600px;">
          <h2>Posts</h2>
          <div class="form-group">
            {
              posts.length === 0 && (
                <div class="form-row">
                  <span style="color: var(--text-label); font-size: 0.95rem;">
                    No posts yet.
                  </span>
                </div>
              )
            }
            {
              posts.map((post) => (
                <a
                  href={`/blog/${post.id}`}
                  style="text-decoration: none; color: inherit;"
                >
                  <div
                    class="form-row"
                    style="flex-direction: column; align-items: flex-start; gap: 2px;"
                  >
                    <div style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                      <span style="font-size: 0.95rem; color: var(--text-main); font-weight: 500;">
                        {post.data.title}
                      </span>
                      <span style="color: var(--accent-blue); font-size: 1rem;">
                        ›
                      </span>
                    </div>
                    <span style="font-size: 0.8rem; color: var(--text-label);">
                      {post.data.pubDate.toLocaleDateString("en-GB", {
                        day: "numeric",
                        month: "short",
                        year: "numeric",
                      })}
                      {post.data.tags?.length > 0 && (
                        <> · {post.data.tags.join(", ")}</>
                      )}
                    </span>
                    {post.data.description && (
                      <span style="font-size: 0.85rem; color: var(--text-secondary); margin-top: 2px;">
                        {post.data.description}
                      </span>
                    )}
                  </div>
                </a>
              ))
            }
          </div>
          <p
            class="form-text"
            style="font-size: 0.8rem; color: var(--text-placeholder); margin-left: 1rem;"
          >
            {posts.length} post{posts.length !== 1 ? "s" : ""}
          </p>
        </div>
      </div>
    </main>
    <Footer />
  </body>
</html>
