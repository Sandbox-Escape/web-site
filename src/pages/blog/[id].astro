---
import { getCollection, render } from "astro:content";
import Navbar from "../../components/navbar.astro";
import Styles from "../../components/styles.astro";
import Banner from "../../components/banner.astro";
import Footer from "../../components/footer.astro";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { id: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Sandbox Escape - {post.data.title}</title>
        <Styles />
        <style>
            .post-content h1,
            .post-content h2,
            .post-content h3 {
                font-weight: 600;
                margin: 1.5rem 0 0.5rem;
                color: var(--text-main);
            }
            .post-content h1 {
                font-size: 1.6rem;
            }
            .post-content h2 {
                font-size: 1.3rem;
            }
            .post-content h3 {
                font-size: 1.1rem;
            }
            .post-content p {
                color: var(--text-secondary);
                line-height: 1.7;
                margin-bottom: 1rem;
            }
            .post-content a {
                color: var(--accent-blue);
                text-decoration: none;
            }
            .post-content a:hover {
                text-decoration: underline;
            }
            .post-content ul,
            .post-content ol {
                color: var(--text-secondary);
                padding-left: 1.5rem;
                margin-bottom: 1rem;
                line-height: 1.7;
            }
            .post-content code {
                background: var(--border-color);
                padding: 2px 6px;
                border-radius: 4px;
                font-size: 0.875rem;
            }
            .post-content pre {
                background: var(--card-bg);
                border: 0.5px solid var(--border-color);
                border-radius: 12px;
                padding: 1rem;
                overflow-x: auto;
                margin-bottom: 1rem;
            }
            .post-content pre code {
                background: none;
                padding: 0;
            }
            .post-content blockquote {
                border-left: 3px solid var(--accent-blue);
                margin: 0 0 1rem;
                padding: 0.5rem 1rem;
                color: var(--text-label);
            }
            .post-content img {
                max-width: 100%;
                border-radius: 12px;
            }
        </style>
    </head>
    <body>
        <Banner />
        <Navbar />
        <main>
            <div class="container mt-4" style="max-width: 700px;">
                <a
                    href="/blog"
                    style="color: var(--accent-blue); font-size: 0.9rem; text-decoration: none;"
                    >← Blog</a
                >
                <h1 style="margin-top: 1rem; font-weight: 700;">
                    {post.data.title}
                </h1>
                <p
                    style="color: var(--text-label); font-size: 0.85rem; margin-bottom: 2rem;"
                >
                    {
                        post.data.pubDate.toLocaleDateString("en-GB", {
                            day: "numeric",
                            month: "short",
                            year: "numeric",
                        })
                    }
                    {
                        post.data.tags?.length > 0 && (
                            <> · {post.data.tags.join(", ")}</>
                        )
                    }
                </p>
                <div class="post-content">
                    <Content />
                </div>
            </div>
        </main>
        <Footer />
    </body>
</html>
