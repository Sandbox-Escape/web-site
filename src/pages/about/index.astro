---
import Navbar from "../../components/navbar.astro";
import Styles from "../../components/styles.astro";
import Banner from "../../components/banner.astro";
import Footer from "../../components/footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Sandbox Escape - About</title>
    <Styles />
  </head>
  <body>
    <Banner />
    <Navbar />
    <main>
      <div class="container mt-4">
        <h1>Who we are</h1>
        <p>
          We are a security research and software development team dedicated to
          making secure and reliable software. We are always open to requests
          for software development. Contact us at <a
            href="mailto:support@sandbox-escape.org"
            >support@sandbox-escape.org</a
          >!
        </p>

        <h1>We <3 Open Source</h1>
        <p>
          How can you ever verify the security claims of software when it is
          closed source? How can you even discover critical vulnerabilities when
          nobody gets to explore the codebase? Those questions are exactly why
          we open source everything we do.
        </p>
      </div>
    </main>
    <Footer />
  </body>
</html>
