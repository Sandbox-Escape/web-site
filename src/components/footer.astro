---
const currentYear = new Date().getFullYear();
---

<footer class="footer-3">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-4">
                <a href="/" class="footer-logo">Sandbox Escape</a>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-6 footer-links">
                <a href="/join">Join our team</a>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <p class="footer-description">
                    Sandbox Escape was founded on 19 July 2025 by Ponder. We are
                    a security research and development organisation that
                    focuses on finding vulnerabilities in modern software.
                </p>
            </div>
        </div>

        <div class="row copyright-section">
            <div class="col-12 text-center">
                <p class="copyright-text">
                    Copyright 2025-{currentYear}. All Rights Reserved unless
                    otherwise stated.
                </p>
            </div>
        </div>
    </div>
</footer>
