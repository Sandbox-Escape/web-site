  <button
    class="navbar-toggler"
    type="button"
    id="nav-toggle"
    aria-label="Toggle navigation"
    aria-expanded="false"
    aria-controls="navbarNav"
  >
    <span class="toggler-icon">
      <svg
        class="icon-hamburger"
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
